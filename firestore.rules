rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "mamun.green213@gmail.com"
      );
    }

    function isValidActivity(data) {
      return data.id is string && data.id.size() <= 128
        && data.activityType in ['summit', 'running']
        && data.date is string && data.date.size() <= 30
        && data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 20000
        && data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 1000
        && data.elevationGainM is number && data.elevationGainM >= 0 && data.elevationGainM <= 15000
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000))
        && (!('mountainId' in data) || (data.mountainId is string && data.mountainId.size() <= 128))
        && (!('mountainName' in data) || (data.mountainName is string && data.mountainName.size() <= 150))
        && (!('koreanName' in data) || (data.koreanName is string && data.koreanName.size() <= 150))
        && (!('peakName' in data) || (data.peakName is string && data.peakName.size() <= 150))
        && (!('weather' in data) || (data.weather is string && data.weather.size() <= 100))
        && (!('companions' in data) || (data.companions is string && data.companions.size() <= 100))
        && (!('trailTaken' in data) || (data.trailTaken is string && data.trailTaken.size() <= 200))
        && (!('location' in data) || (data.location is string && data.location.size() <= 200))
        && (!('title' in data) || (data.title is string && data.title.size() <= 200))
        && (!('paceMinPerKm' in data) || (data.paceMinPerKm is string && data.paceMinPerKm.size() <= 20))
        && (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 200))
        && (!('routeType' in data) || (data.routeType is string && data.routeType.size() <= 100))
        && (!('authorUid' in data) || (data.authorUid is string && data.authorUid.size() <= 128))
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 30));
    }

    match /activities/{activityId} {
      allow read: if true; // Public mountain summits and running activities visible to community

      allow create: if isValidId(activityId)
        && isValidActivity(incoming())
        && (!isSignedIn() || incoming().authorUid == request.auth.uid || isAdmin());

      allow update: if isValidId(activityId)
        && isValidActivity(incoming())
        && (!isSignedIn() || isAdmin() || !('authorUid' in existing()) || existing().authorUid == request.auth.uid)
        && incoming().id == existing().id;

      allow delete: if isValidId(activityId)
        && (!isSignedIn() || isAdmin() || !('authorUid' in existing()) || existing().authorUid == request.auth.uid);
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
